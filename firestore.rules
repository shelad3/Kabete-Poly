rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------- //
    // Helper Functions
    // ---------------------------------------------------- //
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Official';
    }

    function isTeacherOrAbove() {
      return isAuthenticated() && (getUserRole() == 'Teacher' || getUserRole() == 'Official');
    }

    function isLeaderOrAbove() {
      return isAuthenticated() && (getUserRole() == 'Leader' || getUserRole() == 'Teacher' || getUserRole() == 'Official');
    }

    // ---------------------------------------------------- //
    // Users Collection
    // Read scoped: users may read their own profile; Leaders and above may
    // read the directory. Blocks plain Students from bulk-harvesting PII.
    // ---------------------------------------------------- //
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isLeaderOrAbove());
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['role', 'name', 'email']);
      allow update: if isAuthenticated() && isOwner(userId) && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'photoUrl', 'regNo', 'enrolledClasses',
                    'enrolledTerm', 'enrolledYear', 'fcmTokens', 'bio',
                    'gender', 'nationality', 'address'])
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Messages / Forum Collection
    // ---------------------------------------------------- //
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'classId', 'channelId', 'senderId', 'senderName',
          'senderAvatarUrl', 'text', 'imageUrl', 'timestamp', 'reactions',
        ]) &&
        request.resource.data.size() < 100000 &&
        request.resource.data.text.size() < 5000;
      allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------- //
    // Forum Channels
    // ---------------------------------------------------- //
    match /forum_channels/{channelId} {
      allow read: if isAuthenticated();
      allow create: if isLeaderOrAbove();
      allow update: if isTeacherOrAbove();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Grades Collection
    // Read scoped: a user may read only their own grades; Teachers and above
    // may read any (class-wide reporting). Prevents students from querying
    // the whole collection.
    // ---------------------------------------------------- //
    match /grades/{gradeId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAbove()
      );
      allow create, update: if isTeacherOrAbove();
      allow delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Classes / Cohorts Collection + Timetable subcollection
    // ---------------------------------------------------- //
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update: if isLeaderOrAbove();
      allow delete: if isAdmin();

      match /timetable/{entryId} {
        allow read: if isAuthenticated();
        allow create, update: if isTeacherOrAbove();
        allow delete: if isTeacherOrAbove();
      }

      match /exam_timetable/{entryId} {
        allow read: if isAuthenticated();
        allow create, update: if isTeacherOrAbove();
        allow delete: if isTeacherOrAbove();
      }
    }

    // ---------------------------------------------------- //
    // Lessons Collection
    // ---------------------------------------------------- //
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Schedules Collection
    // ---------------------------------------------------- //
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Notifications Collection
    // ---------------------------------------------------- //
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacherOrAbove();
    }
    
    // ---------------------------------------------------- //
    // Auth Codes Collection
    // ---------------------------------------------------- //
    match /auth_codes/{codeId} {
      allow read: if isAdmin();
      // Only admins can create new codes or delete them
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'useCount', 'usedAt']);
    }

    // ---------------------------------------------------- //
    // Help Requests Collection
    // ---------------------------------------------------- //
    match /help_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'title', 'message',
          'timestamp', 'status', 'resolvedBy', 'resolvedAt',
        ]) &&
        request.resource.data.size() < 100000 &&
        request.resource.data.message.size() < 10000 &&
        request.resource.data.title.size() < 500;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Error Reports Collection
    // ---------------------------------------------------- //
    match /error_reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'title', 'message',
          'appVersion', 'timestamp', 'status',
        ]) &&
        request.resource.data.size() < 100000 &&
        request.resource.data.message.size() < 10000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Feedback Collection
    // ---------------------------------------------------- //
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'message', 'rating',
          'timestamp', 'status',
        ]) &&
        request.resource.data.size() < 100000 &&
        request.resource.data.message.size() < 10000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Alerts Collection
    // Read: authenticated (alerts are broadcast announcements). Update:
    // admins may edit; any user may only append their OWN id to readBy
    // (mark-read), never rewrite other fields.
    // ---------------------------------------------------- //
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        request.resource.data.readBy.hasAll(resource.data.readBy) &&
        request.resource.data.readBy.size() >= resource.data.readBy.size() &&
        request.resource.data.readBy.hasAny([request.auth.uid])
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Attendance Collection
    // Read scoped: own records or Teacher+ (class-wide views).
    // ---------------------------------------------------- //
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAbove()
      );
      allow create: if isTeacherOrAbove();
      allow update, delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Field Indices (Uniqueness Enforcement)
    // ---------------------------------------------------- //
    match /field_indices/{indexId} {
      // Registration transaction runs AFTER the auth user is created, so the
      // creator is authenticated. Writes are restricted to the owner of the
      // index; deletes to admins.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered']);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Active QR Sessions (Teacher-controlled QR activation)
    // ---------------------------------------------------- //
    match /active_qr_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrAbove();
      allow update, delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Lesson Verifications (Student vote taught/not taught)
    // Students may create a fresh doc only if it casts THEIR OWN vote, and
    // may update only by appending their own id to one of the vote arrays.
    // Teachers confirm via isConfirmed.
    // ---------------------------------------------------- //
    match /lesson_verifications/{verificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.votesFor.size() <= 1 &&
        request.resource.data.votesAgainst.size() <= 1 &&
        (request.resource.data.votesFor.hasAny([request.auth.uid]) ||
         request.resource.data.votesAgainst.hasAny([request.auth.uid]));
      allow update: if isTeacherOrAbove() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['votesFor', 'votesAgainst']
        ) &&
        request.resource.data.votesFor.hasAll(resource.data.votesFor) &&
        request.resource.data.votesAgainst.hasAll(resource.data.votesAgainst) &&
        request.resource.data.votesFor.size() >= resource.data.votesFor.size() &&
        request.resource.data.votesAgainst.size() >= resource.data.votesAgainst.size() &&
        (request.resource.data.votesFor.hasAny([request.auth.uid]) ||
         request.resource.data.votesAgainst.hasAny([request.auth.uid]))
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Reports (Auto-uploaded report cards)
    // ---------------------------------------------------- //
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAbove()
      );
      allow create: if isTeacherOrAbove();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Class Change Requests Collection
    // ---------------------------------------------------- //
    match /class_change_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // User Sessions subcollection
    // ---------------------------------------------------- //
    match /users/{userId}/sessions/{sessionId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ---------------------------------------------------- //
    // School Info
    // ---------------------------------------------------- //
    match /school_info/{infoId} {
      allow read: if true;  // public — shown to guests too
      allow write: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Events (Event Gallery)
    // ---------------------------------------------------- //
    match /events/{eventId} {
      allow read: if true;  // public — visible to all including guests
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Photos subcollection
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------- //
    // Houses (Buildings containing cubes)
    // ---------------------------------------------------- //
    match /houses/{houseId} {
      allow read: if true;  // public — guests can see house info
      allow write: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Cubes (Workstations within houses)
    // ---------------------------------------------------- //
    match /cubes/{cubeId} {
      allow read: if true;  // public — guests can see cube info
      allow write: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Cube Bookings
    // ---------------------------------------------------- //
    match /cube_bookings/{bookingId} {
      // Students read all bookings for availability checks; teachers manage
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.keys().hasAll(['studentId', 'cubeId', 'term', 'year', 'status']) &&
        request.resource.data.status == 'pending';  // students may only open as pending
      allow update: if isTeacherOrAbove() || (
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'cancelled'
      );
      allow delete: if false;
      // NOTE: One-active-booking-per-student and cube capacity limits are
      // enforced atomically in CubeService.createBooking() via Firestore
      // runTransaction(). Server-side rules cannot efficiently query across
      // documents to enforce these constraints.
    }

    // ---------------------------------------------------- //
    // Quizzes Collection
    // ---------------------------------------------------- //
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrAbove();
      allow update: if isTeacherOrAbove();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Questions Collection (top-level, linked by quizId)
    // ---------------------------------------------------- //
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrAbove();
      allow update: if isTeacherOrAbove();
      allow delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Quiz Submissions Collection
    // ---------------------------------------------------- //
    match /quiz_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTeacherOrAbove()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ---------------------------------------------------- //
    // Lesson Templates Collection
    // ---------------------------------------------------- //
    match /lesson_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrAbove();
      allow update: if isTeacherOrAbove();
      allow delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Schedule Templates Collection
    // ---------------------------------------------------- //
    match /schedule_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isTeacherOrAbove();
      allow update: if isTeacherOrAbove();
      allow delete: if isTeacherOrAbove();
    }

    // ---------------------------------------------------- //
    // Feature Flags (Admin toggle for app features)
    // ---------------------------------------------------- //
    match /feature_flags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Payments (M-Pesa, Airtel, Card transactions)
    // ---------------------------------------------------- //
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAbove()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending';  // students may only initiate
      allow update: if isAdmin();  // admins confirm/refund; students cannot
      allow delete: if false;
    }

    // ---------------------------------------------------- //
    // Waiting List (hostel cube queue)
    // ---------------------------------------------------- //
    match /waitlist/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'waiting';  // students may only enqueue
      allow update: if isTeacherOrAbove() || (
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'expired'
      );
      allow delete: if false;
    }

    // ---------------------------------------------------- //
    // Elections & Voting
    // ---------------------------------------------------- //
    match /elections/{electionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();

      match /positions/{positionId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();

        match /candidates/{candidateId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAdmin();
        }
      }

      match /ballots/{ballotId} {
        // Readable for turnout/tally display. Writes are NOT permitted from
        // clients — ballots are created server-side by the `castVote` Cloud
        // Function (admin SDK bypasses these rules), which enforces
        // one-vote-per-position via the deterministic ballot doc id.
        allow read: if isAuthenticated();
        allow create: if false;
      }
    }

    // ---------------------------------------------------- //
    // Exams & Exam Bookings
    // ---------------------------------------------------- //
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
    }

    match /exam_bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAbove()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'registered';  // seat checks run in transaction
      allow delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacherOrAbove()
      );
    }

    // ---------------------------------------------------- //
    // App Updates (public read — needed before login)
    // Only admin-tool service accounts may create/update docs.
    // Deletes are denied: keeping the last-known-good version prevents
    // a stale client from losing update availability.
    // ---------------------------------------------------- //
    match /app_updates/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------- //
    // Listings (Kejani — apartment/rental finder)
    // Public read so guests can browse; only admins manage.
    // ---------------------------------------------------- //
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------- //
    // Default: deny everything else
    // ---------------------------------------------------- //
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
