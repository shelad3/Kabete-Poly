<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ system splash screen. Shown by the OS before the Flutter
        engine draws. Background matches the KNP indigo branding so it blends
        smoothly into the Flutter SplashScreen.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/primary_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/primary_dark</item>
    </style>
</resources>
